{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "True Mirror",
  "description": "__MSG_extDesc__",
  "version": "0.0.0",
  "default_locale": "en",
  "homepage_url": "https://thefaceanalysis.com/extension",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extName__", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "commands": {
    "open-studio": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "__MSG_cmdOpen__" }
  }
}
